# EffNine Benchmark — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# ---- Cloud Judge (Stage 4+) ----
# Base URL of the OpenAI-compatible judge endpoint
EB_JUDGE_BASE_URL=https://your-conductor-endpoint/v1
# API key for the judge endpoint (leave empty to use env var at runtime)
EB_JUDGE_API_KEY=
# Model to use for judging: "auto" selects from config, or specify a model name
EB_JUDGE_MODEL=auto

# ---- Local Model Inference ----
# Path to local model directory (for local adapter)
EB_LOCAL_MODEL_PATH=
# API key for local inference endpoint (if required by backend)
EB_API_KEY=

# ---- Provider-Specific Keys (optional) ----
# EB_JUDGE_API_KEY takes precedence; these are for other providers if needed
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ---- OpenSandbox Backend (Validated Alternative) ----
# Set EB_SANDBOX_BACKEND=opensandbox to use instead of Docker
# Requires: pip install opensandbox + running OpenSandbox server
EB_OPENSANDBOX_BASE_URL=http://localhost:8080
EB_OPENSANDBOX_API_KEY=
