# Atlas Dataset - git ignore rules

# Secrets and credentials
# Global rule: never commit .env files or credential stores.
.env
.env.*
!.env.example
!.env.example.*

# Large raw artifacts must NOT be committed to git.
# Track them via Git LFS or external storage instead.
raw/external/*
raw/generated/*
raw/documentation/*
raw/conversations/*
raw/personal_knowledge/*
raw/.cache/**
!raw/.cache/.gitkeep
!**/.gitkeep

# Curated bulk data is generated; keep only manifests + samples in git.
curated/v0.1/*.jsonl
curated/v1.0/*.jsonl
!**/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.venv-release/
venv/

# macOS junk
.DS_Store

# Release pipeline artifacts (regenerable; keep metadata + docs in git)
releases/*/dataset/**/*.jsonl.zst
releases/*/dataset/**/*.jsonl
releases/restored/

# Local experiment outputs
outputs/
tmp/
.hermes_tmp/
*.log

# Quality-calibration artifacts
# - the synthetic illustrative seed is NOT real human review; never commit it
review_queue/quality_reviews.example.jsonl
# - the worksheet is deterministically regenerable from candidates
review_queue/calibration_sample.jsonl
# Large regenerable review files (>100MB, exceeds GitHub limit)
review/quality_reviews.jsonl
review_queue/approved.jsonl
# Keep tracked: metadata/calibration_report.json, review_queue/rejected.jsonl,
# review_queue/pending.jsonl (pilot review queue per ADR-007).

# Acquisition Engine ephemeral artifacts (regenerated on each run)
metadata/engine_checkpoint.json
metadata/verification_log.json
metadata/lifecycle_state.json
knowledge_packs/*
!knowledge_packs/.gitkeep
curated/**/data/*
metadata/engine_checksums.json
docs/diff_*.md

# Automation Layer pipeline artifacts (runtime state, not source)
metadata/pipeline_state/
metadata/pipeline_approvals.json
metadata/pipeline_revisions/
metadata/pipeline_retries/
metadata/releases/
metadata/acquisition_logs/
metadata/download_logs/
metadata/etl/
metadata/views/
metadata/release_bundles/
metadata/e2e_reports/
metadata/pipeline_incremental.json

# Release manifests are governance-critical; track them despite ignoring
# other metadata/releases artifacts.
!metadata/releases/
metadata/releases/*
!metadata/releases/*_release.json

# Intelligence Layer ephemeral artifacts (regenerable per release)
metadata/intelligence/_tmp/
metadata/intelligence/unknown_classified_v*.jsonl

# Large model checkpoints (regenerable from training)
*.safetensors
experiments/*/checkpoints/
# Generated evaluation results (large jsonl)
experiments/*/*/evaluation/**/*_results.jsonl
experiments/*/*/evaluation/expanded_*/*.jsonl

# Local AI-agent tool state (never commit)
.codebro/
.opencode/

# Additional local virtualenvs
.venv-nemotron-nano/

# Regenerable caches
unsloth_compiled_cache/
metadata/_training_cache/
*.egg-info/

# Bulk raw acquisition data (17-22GB; manifests and reports live in
# metadata/ and reports/ and ARE tracked)
raw/p0/
raw/p1/

# Local training run artifacts (checkpoints etc.)
artifacts/

# Pilot training-data slices (bulk JSONL, regenerable from pipeline)
pilot/
