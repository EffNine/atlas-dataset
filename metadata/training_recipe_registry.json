{
  "schema": "metadata/training_recipe_registry.json",
  "schema_version": "1.0",
  "description": "Canonical registry of declarative training recipes for Atlas Dataset Foundation. Each recipe defines the filter policy, quality thresholds, and validation requirements for generating reproducible training views.",
  "updated": "2026-07-28",
  "registry": {
    "recipe_sft_v0.2": {
      "recipe_id": "recipe_sft_v0.2",
      "purpose": "SFT-ready training view from approved v0.2 release records. Filters to quality >= 7, approved verification only, valid licenses.",
      "dataset_version": "v0.2",
      "quality_threshold": 7,
      "filter_policy": {
        "verification_required": "approved",
        "lifecycle_states": ["approved", "released"],
        "license_filter": "denied_and_unknown_excluded",
        "minimum_lineage_completeness": "all_fields",
        "eligibility_required": true
      },
      "tokenization_policy": {
        "max_sequence_length": 8192,
        "truncation_strategy": "tail",
        "add_special_tokens": true,
        "tokenizer_model": "inherit_from_target"
      },
      "validation_policy": {
        "require_determinism": true,
        "check_checksums": true,
        "validate_per_record": true,
        "verify_manifest_schema": true
      },
      "supported_models": ["qwen", "llama", "deepseek"],
      "min_atlas_version": "1.0.0",
      "sampling_strategy": "none",
      "max_records": null
    },
